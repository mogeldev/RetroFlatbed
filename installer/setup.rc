#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "setup.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName", "RetroFlatbed"
      VALUE "FileDescription", "RetroFlatbed Setup"
      VALUE "ProductVersion", "0.1.0"
      VALUE "FileVersion", "0.1.0.0"
      VALUE "LegalCopyright", "GPL-2.0-or-later; engine derived from the SANE plustek backend"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

IDI_APP ICON "retroflatbed.ico"

IDD_SETUP DIALOGEX 0, 0, 320, 220
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_THICKFRAME | WS_CLIPCHILDREN
CAPTION "RetroFlatbed Setup"
FONT 9, "Segoe UI"
BEGIN
    ICON            IDI_APP, IDC_LOGO, 0, 0, 0, 0
    LTEXT           "RetroFlatbed", IDC_TITLE, 0, 0, 10, 10
    LTEXT           "", IDC_SUBTITLE, 0, 0, 10, 10
    GROUPBOX        "Install for", IDC_GROUP, 0, 0, 10, 10
    CONTROL         "&WIA  -  scanner appears in Windows (Windows Scan, Paint, Fax and Scan, ...)", IDC_RADIO_WIA, "Button", BS_AUTORADIOBUTTON | BS_MULTILINE | WS_GROUP | WS_TABSTOP, 0, 0, 10, 10
    CONTROL         "&TWAIN  -  for NAPS2 and other TWAIN programs (32- and 64-bit)", IDC_RADIO_TWAIN, "Button", BS_AUTORADIOBUTTON | BS_MULTILINE, 0, 0, 10, 10
    CONTROL         "&Both  (WIA and TWAIN)", IDC_RADIO_BOTH, "Button", BS_AUTORADIOBUTTON | BS_MULTILINE, 0, 0, 10, 10
    LTEXT           "Choosing an option replaces whatever RetroFlatbed parts are installed now.", IDC_HINT, 0, 0, 10, 10
    LTEXT           "", IDC_STATE, 0, 0, 10, 10
    CONTROL         "", IDC_PROGRESS, "msctls_progress32", WS_BORDER, 0, 0, 10, 10
    LISTBOX         IDC_LOG, 0, 0, 10, 10, LBS_NOINTEGRALHEIGHT | LBS_NOSEL | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    LTEXT           "Installing adds a self-signed certificate to this PC's trusted publishers (so Windows accepts the driver); Uninstall removes it again. Close programs that use the scanner first. Not affiliated with Canon or the SANE project.", IDC_NOTE, 0, 0, 10, 10
    PUSHBUTTON      "&Uninstall...", IDC_UNINSTALL, 0, 0, 10, 10
    DEFPUSHBUTTON   "&Install", IDC_INSTALL, 0, 0, 10, 10
    PUSHBUTTON      "&Close", IDC_CLOSE, 0, 0, 10, 10
END
#include "payload.rc"
