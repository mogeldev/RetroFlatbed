#include <windows.h>
#include "ds_res.h"

IDD_SCAN DIALOGEX 0, 0, 230, 190
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Canon CanoScan LiDE 20"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Mode:",IDC_STATIC,10,12,60,8
    COMBOBOX        IDC_MODE,75,10,140,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Resolution (dpi):",IDC_STATIC,10,30,60,8
    COMBOBOX        IDC_DPI,75,28,140,100,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Bit depth:",IDC_STATIC,10,48,60,8
    COMBOBOX        IDC_DEPTH,75,46,140,60,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Scan area:",IDC_STATIC,10,66,60,8
    COMBOBOX        IDC_AREA,75,64,140,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Left (mm):",IDC_STATIC,10,86,60,8
    EDITTEXT        IDC_LEFT,75,84,40,12,ES_AUTOHSCROLL
    LTEXT           "Top (mm):",IDC_STATIC,125,86,40,8
    EDITTEXT        IDC_TOP,175,84,40,12,ES_AUTOHSCROLL
    LTEXT           "Width (mm):",IDC_STATIC,10,104,60,8
    EDITTEXT        IDC_WIDTH,75,102,40,12,ES_AUTOHSCROLL
    LTEXT           "Height (mm):",IDC_STATIC,125,104,45,8
    EDITTEXT        IDC_HEIGHT,175,102,40,12,ES_AUTOHSCROLL
    LTEXT           "Brightness (-100..100):",IDC_STATIC,10,126,80,8
    EDITTEXT        IDC_BRIGHT,95,124,30,12,ES_AUTOHSCROLL
    LTEXT           "Contrast:",IDC_STATIC,135,126,35,8
    EDITTEXT        IDC_CONTRAST,175,124,40,12,ES_AUTOHSCROLL
    LTEXT           "",IDC_STATUS,10,146,205,16
    DEFPUSHBUTTON   "Scan",IDOK,100,168,55,14
    PUSHBUTTON      "Cancel",IDCANCEL,160,168,55,14
END
